{
  "name": "github-cognito-openid-wrapper",
  "version": "1.3.9",
  "description": "A wrapper to enable AWS Cognito User Pools (which requires OpenID Connect) to talk to GitHub (which only provides OAuth2.0)",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimothyJones/github-cognito-openid-wrapper.git"
  },
  "files": [
    "src/**/*",
    "scripts/**/*",
    "webpack.config.js",
    "babel.config.js",
    "package.json",
    "package-lock.json"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage pacts node_modules dist*",
    "build": "webpack",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test-dev": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch",
    "start": "webpack --watch --stats minimal",
    "lint": "eslint src --ext .ts,.js --config .eslintrc.json",
    "preinstall": "bash ./scripts/create-key.sh",
    "prebuild-dist": "npm run lint && npm run test",
    "build-dist": "npm run build",
    "predeploy": "npm run build-dist",
    "prerelease": "npm run lint && npm run test && npm run build",
    "format:base": "prettier \"src/**/*.{ts,js}\"",
    "format:fix": "npm run format:base -- --write",
    "format:check": "npm run format:base -- --check",
    "release": "commit-and-tag-version",
    "deploy": "bash ./scripts/deploy.sh",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "prepare": "#npm run snyk-protect",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@snyk/protect": "^1.1235.0",
    "axios": "^1.6.3",
    "body-parser": "^1.20.2",
    "colors": "^1.4.0",
    "express": "^4.18.1",
    "json-web-key": "^0.4.0",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.8.2",
    "winston-splunk-httplogger": "^3.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.3",
    "@jest/globals": "^29.7.0",
    "@pact-foundation/pact": "^13.2.0",
    "@pact-foundation/pact-core": "^15.2.1",
    "all-contributors-cli": "^6.17.2",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "commit-and-tag-version": "^10.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "jest": "^29.7.0",
    "jest-pact": "^0.11.1",
    "nodemon": "^2.0.20",
    "nodemon-webpack-plugin": "^4.8.2",
    "prettier": "^3.1.1",
    "raw-loader": "^0.5.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^2.5.2",
    "winston-transport": "^4.9.0"
  },
  "overrides": {
    "glob": "^9.3.5",
    "debug": "^4.3.4"
  }
}
